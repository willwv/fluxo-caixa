# Copie este arquivo para ".env" antes de rodar "docker-compose up".
# Nenhum valor real de produção deve ser commitado - estes são apenas defaults de demonstração local.

# --- Banco de Lançamentos (sem réplica) ---
LANCAMENTOS_DB_USER=postgres
LANCAMENTOS_DB_PASSWORD=changeme
LANCAMENTOS_DB_NAME=lancamentos

# --- Banco de Consolidado (primary + read replica) ---
CONSOLIDADO_DB_USER=postgres
CONSOLIDADO_DB_PASSWORD=changeme
CONSOLIDADO_DB_NAME=consolidado
CONSOLIDADO_REPLICATION_USER=replicator
CONSOLIDADO_REPLICATION_PASSWORD=changeme

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Autenticação ---
# Chave de assinatura JWT (compartilhada entre os dois serviços) - use uma string aleatória longa.
JWT_SIGNING_KEY=troque-esta-chave-por-uma-string-aleatoria-com-pelo-menos-32-caracteres
# Pepper somado à senha antes do hash BCrypt (nunca fica no banco).
PASSWORD_PEPPER=troque-este-pepper-por-outra-string-aleatoria

# --- Usuário seed (único usuário do sistema) ---
SEED_USER_USERNAME=comerciante
SEED_USER_PASSWORD=TrocarEssaSenha!123
